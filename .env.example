# Copy to .env, replace placeholder secrets, then load it:
# set -a; . ./.env; set +a

# Required at startup. Only the URL scheme and host are used.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Required for a healthy service and authenticated proxy traffic.
NVIDIA_API_KEY=replace-with-your-nvidia-api-key
PROXY_AUTH_TOKEN=replace-with-a-long-random-token

# Optional. Defaults are shown. Timeout values accept non-negative seconds; 0 disables them.
PORT=10000
UPSTREAM_CONNECT_TIMEOUT_SECONDS=30
UPSTREAM_IDLE_TIMEOUT_SECONDS=120
